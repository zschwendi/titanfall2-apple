  gate2_run_14 },
{ 15, "Plat_GetProcAddress",
  NEEDS_IMPORTS | NEEDS_ENTRY,
  "(\"Kernel32.dll\", \"GetTickCount\"), (\"Kernel32.dll\", \"NoSuchExport\"), (\"NoSuchLibrary.dll\", \"X\"), and a lifted game module such as (\"vstdlib.dll\", \"RandomInt\").",
  "Non-null equals what GetProcAddress gives for the same pair; the failures return NULL; the game-module answer equals vstdlib base + the export RVA.",
