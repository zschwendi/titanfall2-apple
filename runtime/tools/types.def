# Sockets (rt/net.h, rt/win/net.h): wsock32, ws2_32, iphlpapi.  The lower-case names of the
# Windows headers (sockaddr, fd_set, timeval, hostent, addrinfo) clash with the host's, so a
# SHIM line uses the upper-case typedefs.  A SOCKET is class u64, not handle: it is an integer
# type, and the game passes it sign-extended from an int.
SOCKET                  u64
WSADATA                 struct   408
LPWSADATA               ptr
IN_ADDR                 struct8  4
IN6_ADDR                struct   16
SOCKADDR                struct   16
