# Written by hand: a test-only interface for the tests of the interface layer
# (runtime/tests/core/com_*.c).  Format: runtime/com/gen_desc.py.  The test program registers
# this set itself (runtime/tests/harness.c); the runtime does not contain it.
interface IRtTestShape
iid       7e57c0de-0002-4000-8000-00000000c0de
owner     rttest.dll
header    rttest
inherits  IRtTestNamed 7e57c0de-0001-4000-8000-00000000c0de 5
inherits  IUnknown 00000000-0000-0000-c000-000000000046 3
  0  IUnknown      HRESULT QueryInterface(REFIID riid, void **ppvObject)
  1  IUnknown      ULONG AddRef(void)
  2  IUnknown      ULONG Release(void)
  3  IRtTestNamed  UINT GetTag(void)                    # body: bodies/IRtTestNamed, the base's
  4  IRtTestNamed  HRESULT SetTag(UINT tag)             # body: bodies/IRtTestNamed, the base's
  5  IRtTestShape  HRESULT Mix(UINT a, FLOAT b, UINT64 c, double d, UINT8 e, const char *text, UINT *out)
  6  IRtTestShape  FLOAT Scale(FLOAT x)
  7  IRtTestShape  HRESULT Touch(UINT flags)            # accept
  8  IRtTestShape  void Poke(void *p)                   # accept
  9  IRtTestShape  HRESULT NotBuilt(RTTEST_KIND kind, const RTTEST_DESC *desc, REFIID riid, IRtTestCounter *other, FLOAT ratio, const char *label)
