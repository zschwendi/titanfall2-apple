new file mode 100644
index 0000000..d3b0fe6
--- /dev/null
+++ b/include/native/dxmt_native_display.h
@@ -0,0 +1,21 @@
+#ifndef DXMT_NATIVE_DISPLAY_H
+#define DXMT_NATIVE_DISPLAY_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* iOS has no global desktop modes. The host publishes its actual drawable
+ * dimensions and screen refresh rate before starting the game, and on resize.
+ * Queries are thread-safe and never dispatch synchronously into UIKit. */
+struct DXMTNativeDisplay {
+  uint32_t width, height;
+  uint32_t refresh_numerator, refresh_denominator;
+};
+int DXMTSetNativeDisplay(const struct DXMTNativeDisplay *display);
+int DXMTGetNativeDisplay(struct DXMTNativeDisplay *display);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
