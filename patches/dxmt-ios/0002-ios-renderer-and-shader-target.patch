diff --git a/src/nativemetal/native_display.c b/src/nativemetal/native_display.c
new file mode 100644
index 0000000..3733ac4
--- /dev/null
+++ b/src/nativemetal/native_display.c
@@ -0,0 +1,25 @@
+#include "native/dxmt_native_display.h"
+#include <limits.h>
+#include <pthread.h>
+
+static pthread_mutex_t display_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct DXMTNativeDisplay current_display;
+
+int DXMTSetNativeDisplay(const struct DXMTNativeDisplay *display) {
+  if (!display || !display->width || !display->height ||
+      display->width > INT_MAX || display->height > INT_MAX ||
+      !display->refresh_numerator || !display->refresh_denominator)
+    return 0;
+  pthread_mutex_lock(&display_lock);
+  current_display = *display;
+  pthread_mutex_unlock(&display_lock);
+  return 1;
+}
+
+int DXMTGetNativeDisplay(struct DXMTNativeDisplay *display) {
+  if (!display) return 0;
+  pthread_mutex_lock(&display_lock);
+  *display = current_display;
+  pthread_mutex_unlock(&display_lock);
+  return display->width && display->height;
+}
