diff --git a/src/util/wsi_monitor_ios.cpp b/src/util/wsi_monitor_ios.cpp
new file mode 100644
index 0000000..c8b7e0a
--- /dev/null
+++ b/src/util/wsi_monitor_ios.cpp
@@ -0,0 +1,46 @@
+#include "wsi_monitor.hpp"
+#include "native/dxmt_native_display.h"
+#include <cwchar>
+
+namespace dxmt::wsi {
+
+static HMONITOR appMonitor() { return reinterpret_cast<HMONITOR>(uintptr_t(1)); }
+static bool readDisplay(HMONITOR monitor, DXMTNativeDisplay &display) {
+  return monitor == appMonitor() && DXMTGetNativeDisplay(&display);
+}
+
+HMONITOR enumMonitors(uint32_t index) {
+  DXMTNativeDisplay display{};
+  return index == 0 && DXMTGetNativeDisplay(&display) ? appMonitor() : nullptr;
+}
+HMONITOR getDefaultMonitor() { return enumMonitors(0); }
+
+bool getDisplayName(HMONITOR monitor, WCHAR (&name)[32]) {
+  DXMTNativeDisplay display{};
+  if (!readDisplay(monitor, display)) return false;
+  std::swprintf(name, 32, L"\\\\.\\DISPLAY1");
+  return true;
+}
+
+bool getDesktopCoordinates(HMONITOR monitor, RECT *rect) {
+  DXMTNativeDisplay display{};
+  if (!rect || !readDisplay(monitor, display)) return false;
+  *rect = {0, 0, LONG(display.width), LONG(display.height)};
+  return true;
+}
+
+bool getCurrentDisplayMode(HMONITOR monitor, WsiMode *mode) {
+  DXMTNativeDisplay display{};
+  if (!mode || !readDisplay(monitor, display)) return false;
+  *mode = {display.width, display.height,
+           {display.refresh_numerator, display.refresh_denominator}, 32, false};
+  return true;
+}
+bool getDesktopDisplayMode(HMONITOR monitor, WsiMode *mode) {
+  return getCurrentDisplayMode(monitor, mode);
+}
+bool getDisplayMode(HMONITOR monitor, uint32_t index, WsiMode *mode) {
+  return index == 0 && getCurrentDisplayMode(monitor, mode);
+}
+
+} // namespace dxmt::wsi
