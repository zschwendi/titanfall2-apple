@@ -48,7 +49,16 @@ void Logger::log(LogLevel level, const std::string &message) {
 }
 
 void Logger::emitMsg(LogLevel level, const std::string &message) {
-  if (level >= m_minLevel) {
+  // DXMT writes the lines DXMT_LOG_LEVEL lets through; a host program's log
+  // function (native build) gets those and, in addition, every error line.
+  const bool write = level >= m_minLevel;
+#ifndef _WIN32
+  const bool host_only = !write && level == LogLevel::Error;
+#else
+  const bool host_only = false;
+#endif
+
+  if (write || host_only) {
     std::lock_guard<dxmt::mutex> lock(m_mutex);
 
     static std::array<const char *, 5> s_prefixes = {
@@ -56,7 +66,7 @@ void Logger::emitMsg(LogLevel level, const std::string &message) {
 
     const char *prefix = s_prefixes.at(static_cast<uint32_t>(level));
 
-    if (!std::exchange(m_initialized, true)) {
+    if (write && !std::exchange(m_initialized, true)) {
 #ifdef _WIN32
       HMODULE ntdll = GetModuleHandleA("ntdll.dll");
 
@@ -74,6 +84,10 @@ void Logger::emitMsg(LogLevel level, const std::string &message) {
     std::string line;
 
     while (std::getline(stream, line, '\n')) {
+      // the host hears the line first; a non-zero answer means "do not write it"
+      if (DXMTHostLog(static_cast<int>(level), line.c_str()) || host_only)
+        continue;
+
       std::stringstream outstream;
       outstream << prefix << line << std::endl;
 
