diff --git a/src/nativemetal/host_hooks.c b/src/nativemetal/host_hooks.c
new file mode 100644
index 0000000..3fa5e0e
--- /dev/null
+++ b/src/nativemetal/host_hooks.c
@@ -0,0 +1,72 @@
+/*
+ * The host program's log and abort functions in a native (no Wine) build.
+ * See include/native/dxmt_native_host.h.
+ *
+ * This file is part of winemetal.dylib because that is the one library every
+ * other DXMT library links against: dxgi and d3d11 each carry or borrow a
+ * copy of the logger, and one registration has to reach all of them.
+ */
+
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "native/dxmt_native_host.h"
+
+static _Atomic(DXMTHostLogFunction) host_log_function;
+static _Atomic(void *) host_log_user;
+static _Atomic(DXMTHostAbortFunction) host_abort_function;
+static _Atomic(void *) host_abort_user;
+
+void
+DXMTSetHostLogFunction(DXMTHostLogFunction function, void *user) {
+  atomic_store(&host_log_function, NULL);
+  atomic_store(&host_log_user, user);
+  atomic_store(&host_log_function, function);
+}
+
+void
+DXMTSetHostAbortFunction(DXMTHostAbortFunction function, void *user) {
+  atomic_store(&host_abort_function, NULL);
+  atomic_store(&host_abort_user, user);
+  atomic_store(&host_abort_function, function);
+}
+
+int
+DXMTHostLog(int level, const char *line) {
+  DXMTHostLogFunction function = atomic_load(&host_log_function);
+  if (!function)
+    return 0;
+  return function(atomic_load(&host_log_user), level, line);
+}
+
+void
+DXMTHostAbort(const char *message) {
+  DXMTHostAbortFunction function = atomic_load(&host_abort_function);
+  if (function)
+    function(atomic_load(&host_abort_user), message ? message : "");
+  abort();
+}
+
+/*
+ * A failed assert() in a build with assertions.  Apple's <assert.h> expands
+ * assert(e) to a call of __assert_rtn, which libSystem defines: it prints the
+ * expression and calls abort(), and the host would learn only of a SIGABRT.
+ * Defined and exported here, the name is found in winemetal.dylib first by
+ * this library and by every library that links against it (dxgi, d3d11), so
+ * their assertions go through the host's abort function with the text.
+ * Programs that do not link winemetal.dylib (the airconv tool) keep
+ * libSystem's.
+ */
+void
+__assert_rtn(const char *function, const char *file, int line, const char *expression) {
+  char message[1024];
+  if (function)
+    snprintf(message, sizeof(message), "Assertion failed: (%s), function %s, file %s, line %d.", expression, function,
+             file, line);
+  else
+    snprintf(message, sizeof(message), "Assertion failed: (%s), file %s, line %d.", expression, file, line);
+  fprintf(stderr, "%s\n", message);
+  fflush(stderr);
+  DXMTHostAbort(message);
+}
