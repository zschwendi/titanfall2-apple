diff --git a/include/native/dxmt_native_host.h b/include/native/dxmt_native_host.h
new file mode 100644
index 0000000..0daf83a
--- /dev/null
+++ b/include/native/dxmt_native_host.h
@@ -0,0 +1,90 @@
+/*
+ * What the host program hears from DXMT's native (no Wine) build.
+ *
+ * A program that loads DXMT's libraries itself has no Wine console to read
+ * and may not be looking at DXMT's log file.  It can register two functions:
+ *
+ *  - a log function, called for every line DXMT logs, before DXMT writes the
+ *    line anywhere;
+ *  - an abort function, called with the reason just before DXMT ends the
+ *    process with abort().
+ *
+ * One registration covers dxgi.dylib, d3d11.dylib and winemetal.dylib: the
+ * registered pointers live in winemetal.dylib, which the other two link
+ * against, and all four functions below are exported from it
+ * (dlsym(handle of winemetal.dylib, "DXMTSetHostLogFunction"), or
+ * RTLD_DEFAULT when the libraries were opened RTLD_GLOBAL).
+ *
+ * Rules for the host:
+ *  - Register before the first call into DXGI or Direct3D.  Registering
+ *    later is allowed; lines logged before that are not repeated.  Passing
+ *    NULL removes a function.
+ *  - Both functions are called on whatever thread DXMT is on at that moment:
+ *    a thread of the host that is inside a DXGI or Direct3D call, or one of
+ *    DXMT's own threads (command encoding, GPU completion, shader
+ *    compilation).  The log function is called with DXMT's logger locked, so
+ *    one call at a time; the abort function can be entered by two threads at
+ *    once if two fail at once.
+ *  - Neither function may call into DXGI or Direct3D.  Neither may assume
+ *    that DXMT's objects are in a usable state.
+ *  - Which lines the log function gets: the lines DXMT_LOG_LEVEL lets through
+ *    (default: info and above), and every error line whatever DXMT_LOG_LEVEL
+ *    says (so DXMT_LOG_LEVEL=none silences DXMT's own output and not the
+ *    host's view of errors).
+ *  - What reaches the abort function: UNIMPLEMENTED paths of d3d11, failed
+ *    assertions (in a build with assertions: D3D11_ASSERT and the C assert()
+ *    of all three libraries), a pure virtual call, a swap chain whose layer
+ *    could not be attached, a failure to load DXMT's internal Metal library.
+ *    Not everything: abort(), std::terminate() and traps reached any other
+ *    way (an uncaught C++ exception, LLVM's own fatal errors, a failed
+ *    reference-count check) arrive as SIGABRT or SIGTRAP with no call here.
+ *    A host that must report every death installs handlers for those too.
+ */
+
+#ifndef DXMT_NATIVE_HOST_H
+#define DXMT_NATIVE_HOST_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Levels, as DXMT's logger numbers them (DXMT_LOG_LEVEL's names). */
+#define DXMT_HOST_LOG_TRACE 0
+#define DXMT_HOST_LOG_DEBUG 1
+#define DXMT_HOST_LOG_INFO 2
+#define DXMT_HOST_LOG_WARN 3
+#define DXMT_HOST_LOG_ERROR 4
+
+/*
+ * One logged line: no level prefix, no newline, valid only during the call.
+ * A message of several lines arrives as several calls.
+ * Return 0 and DXMT goes on to write the line to standard error and to its
+ * log file as it always did; return non-zero and DXMT writes it nowhere.
+ */
+typedef int (*DXMTHostLogFunction)(void *user, int level, const char *line);
+
+/*
+ * DXMT is about to call abort().  `message` says why (for example
+ * "d3d11_context_imm.cpp:Map: "map-on-default: map"." or
+ * "Assertion failed: (expr), function f, file x.cpp, line 12.") and is valid
+ * only during the call.  The function may end the process itself; if it
+ * returns, DXMT calls abort().
+ */
+typedef void (*DXMTHostAbortFunction)(void *user, const char *message);
+
+void DXMTSetHostLogFunction(DXMTHostLogFunction function, void *user);
+void DXMTSetHostAbortFunction(DXMTHostAbortFunction function, void *user);
+
+/*
+ * For DXMT's own code, not for the host.
+ * DXMTHostLog returns what the host's function returned, 0 without one.
+ * DXMTHostAbort calls the host's function, if any, and then abort().
+ */
+int DXMTHostLog(int level, const char *line);
+void DXMTHostAbort(const char *message) __attribute__((noreturn));
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* DXMT_NATIVE_HOST_H */
