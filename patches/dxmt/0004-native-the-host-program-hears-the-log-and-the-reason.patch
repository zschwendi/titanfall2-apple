+#pragma once
+
+/*
+ * The host program's log and abort functions (native build only):
+ * include/native/dxmt_native_host.h, defined in src/nativemetal/host_hooks.c.
+ * Under Wine there is no host program and both do what DXMT always did.
+ */
+
+#ifndef _WIN32
+
+#include "native/dxmt_native_host.h"
+
+#else
+
+#include <stdlib.h>
+
+static inline int DXMTHostLog(int, const char *) { return 0; }
+[[noreturn]] static inline void DXMTHostAbort(const char *) { abort(); }
+
+#endif
