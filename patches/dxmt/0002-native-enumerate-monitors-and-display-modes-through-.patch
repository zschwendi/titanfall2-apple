 #include "wsi_monitor.hpp"
 
+// not <CoreGraphics/CoreGraphics.h>: it reaches IOKit headers that use
+// "interface" as an identifier, which windows_base.h defines as a macro
+#include <CoreGraphics/CGDirectDisplay.h>
+#include <CoreGraphics/CGDisplayConfiguration.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cwchar>
+#include <vector>
+
+/*
+ * Native build: monitors are the online CoreGraphics displays that do not
+ * mirror another display.  (Not the "active" ones: that list is empty while
+ * the display sleeps, and an application must not lose its outputs then.)
+ *
+ *  - An HMONITOR is a CGDirectDisplayID (never 0 for a real display).
+ *  - enumMonitors(0) is the main display, like DXGI's output 0.
+ *  - Coordinates and mode sizes are in points of the global display space
+ *    (origin at the top left of the main display, y down), the unit
+ *    CGDisplayBounds() and CGDisplayModeGetWidth() use.  On a Retina display a
+ *    mode's size in points is smaller than its size in pixels.
+ *  - Display modes are only reported, never set.
+ *
+ * The CoreGraphics display functions used here may be called from any thread.
+ */
+
 namespace dxmt::wsi {
 
+static inline CGDirectDisplayID toDisplayId(HMONITOR hMonitor) {
+  return CGDirectDisplayID(reinterpret_cast<uintptr_t>(hMonitor));
+}
+
+static inline HMONITOR toMonitor(CGDirectDisplayID displayId) {
+  return reinterpret_cast<HMONITOR>(uintptr_t(displayId));
+}
+
+static std::vector<CGDirectDisplayID> displayList() {
+  uint32_t count = 0;
+  if (CGGetOnlineDisplayList(0, nullptr, &count) != kCGErrorSuccess || !count)
+    return {};
+
+  std::vector<CGDirectDisplayID> displays(count);
+  if (CGGetOnlineDisplayList(count, displays.data(), &count) != kCGErrorSuccess)
+    return {};
+  displays.resize(count);
+
+  std::erase_if(displays, [](CGDirectDisplayID displayId) {
+    return CGDisplayMirrorsDisplay(displayId) != kCGNullDirectDisplay;
+  });
+
+  auto main = std::find(displays.begin(), displays.end(), CGMainDisplayID());
+  if (main != displays.end())
+    std::rotate(displays.begin(), main, main + 1);
+
+  return displays;
+}
+
+static void convertMode(CGDisplayModeRef mode, WsiMode *pMode) {
+  // 0 means "no fixed rate" (some built-in panels)
+  double refreshRate = CGDisplayModeGetRefreshRate(mode);
+  if (!(refreshRate > 0.0))
+    refreshRate = 60.0;
+
+  pMode->width = uint32_t(CGDisplayModeGetWidth(mode));
+  pMode->height = uint32_t(CGDisplayModeGetHeight(mode));
+  pMode->refreshRate = WsiRational{uint32_t(std::lround(refreshRate * 1000.0)), 1000};
+  pMode->bitsPerPixel = 32;
+  pMode->interlaced = false;
+}
+
+static bool currentMode(CGDirectDisplayID displayId, WsiMode *pMode) {
+  CGDisplayModeRef mode = CGDisplayCopyDisplayMode(displayId);
+  if (!mode)
+    return false;
+
+  convertMode(mode, pMode);
+  CGDisplayModeRelease(mode);
+  return true;
+}
+
+/*
+ * The current mode first, then every mode CoreGraphics considers usable for
+ * the desktop, without duplicates (the same size and rate usually exists both
+ * as a 1x and as a HiDPI mode).
+ */
+static std::vector<WsiMode> displayModes(CGDirectDisplayID displayId) {
+  std::vector<WsiMode> modes;
+
+  auto add = [&modes](const WsiMode &mode) {
+    for (const auto &known : modes) {
+      if (known.width == mode.width && known.height == mode.height &&
+          known.refreshRate.numerator == mode.refreshRate.numerator)
+        return;
+    }
+    modes.push_back(mode);
+  };
+
+  WsiMode mode = {};
+  if (!currentMode(displayId, &mode))
+    return modes;
+  add(mode);
+
+  const void *keys[] = {kCGDisplayShowDuplicateLowResolutionModes};
+  const void *values[] = {kCFBooleanTrue};
+  CFDictionaryRef options = CFDictionaryCreate(
+      kCFAllocatorDefault, keys, values, 1, &kCFTypeDictionaryKeyCallBacks,
+      &kCFTypeDictionaryValueCallBacks);
+  CFArrayRef all = CGDisplayCopyAllDisplayModes(displayId, options);
+  if (options)
+    CFRelease(options);
+
+  if (all) {
+    for (CFIndex i = 0, count = CFArrayGetCount(all); i < count; i++) {
+      auto candidate = CGDisplayModeRef(const_cast<void *>(CFArrayGetValueAtIndex(all, i)));
+      if (!CGDisplayModeIsUsableForDesktopGUI(candidate))
+        continue;
+      convertMode(candidate, &mode);
+      add(mode);
+    }
+    CFRelease(all);
+  }
+
+  return modes;
+}
+
 HMONITOR getDefaultMonitor() {
-  return nullptr;
+  return enumMonitors(0);
 }
 
 HMONITOR enumMonitors(uint32_t index) {
-  return nullptr;
+  auto displays = displayList();
+  return index < displays.size() ? toMonitor(displays[index]) : nullptr;
 }
 
 bool getDisplayName(HMONITOR hMonitor, WCHAR (&Name)[32]) {
-  return false;
+  auto displays = displayList();
+  auto it = std::find(displays.begin(), displays.end(), toDisplayId(hMonitor));
+  if (!hMonitor || it == displays.end())
+    return false;
+
+  std::swprintf(Name, 32, L"\\\\.\\DISPLAY%u", unsigned(it - displays.begin()) + 1);
+  return true;
 }
 
 bool getDesktopCoordinates(HMONITOR hMonitor, RECT *pRect) {
-  return false;
-}
+  if (!hMonitor || !CGDisplayIsOnline(toDisplayId(hMonitor)))
+    return false;
 
-static inline bool retrieveDisplayMode(HMONITOR hMonitor, DWORD modeNumber,
-                                       WsiMode *pMode) {
-  return false;
