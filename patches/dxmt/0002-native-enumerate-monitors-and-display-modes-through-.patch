 bool getDisplayMode(HMONITOR hMonitor, uint32_t modeNumber, WsiMode *pMode) {
-  return retrieveDisplayMode(hMonitor, modeNumber, pMode);
+  // Callers walk the list from 0 until this fails: build it once per walk.
+  static thread_local CGDirectDisplayID cachedDisplay = kCGNullDirectDisplay;
+  static thread_local std::vector<WsiMode> cachedModes;
+
+  if (!hMonitor)
+    return false;
+
+  if (modeNumber == 0 || cachedDisplay != toDisplayId(hMonitor)) {
+    cachedDisplay = toDisplayId(hMonitor);
+    cachedModes = displayModes(cachedDisplay);
+  }
+
+  if (modeNumber >= cachedModes.size())
+    return false;
+
+  *pMode = cachedModes[modeNumber];
+  return true;
 }
 
 bool getCurrentDisplayMode(HMONITOR hMonitor, WsiMode *pMode) {
-  return retrieveDisplayMode(hMonitor, ENUM_CURRENT_SETTINGS, pMode);
+  return hMonitor && currentMode(toDisplayId(hMonitor), pMode);
