diff --git a/src/util/wsi_window_headless.cpp b/src/util/wsi_window_headless.cpp
index 382e150..53424e6 100644
--- a/src/util/wsi_window_headless.cpp
+++ b/src/util/wsi_window_headless.cpp
@@ -11,21 +11,46 @@
 #include "wsi_window.hpp"
 #include "wsi_monitor.hpp"
 
+#include "native/dxmt_native_window.h"
+
 #include "util_string.hpp"
 #include "log/log.hpp"
 
 namespace dxmt::wsi {
 
+/*
+ * Native build: there is no window system behind an HWND.  An HWND is a
+ * pointer to a DXMTNativeWindow that the host program owns (see
+ * include/native/dxmt_native_window.h); everything here is answered from it.
+ * Fullscreen and display mode changes are not available.
+ */
+static const DXMTNativeWindow *nativeWindow(HWND hWindow) {
+  auto window = reinterpret_cast<const DXMTNativeWindow *>(hWindow);
+  if (!window || window->magic != DXMT_NATIVE_WINDOW_MAGIC ||
+      window->version != DXMT_NATIVE_WINDOW_VERSION || !window->metal_layer)
+    return nullptr;
+  return window;
+}
+
 void getWindowSize(HWND hWindow, uint32_t *pWidth, uint32_t *pHeight) {
+  uint32_t width = 0, height = 0;
+
+  auto window = nativeWindow(hWindow);
+  if (window && window->get_client_size)
+    window->get_client_size(window->user, &width, &height);
+
   if (pWidth)
-    *pWidth = 1024;
+    *pWidth = width;
 
   if (pHeight)
-    *pHeight = 1024;
+    *pHeight = height;
 }
 
 void resizeWindow(HWND hWindow, DXMTWindowState *pState, uint32_t width,
                   uint32_t height) {
+  auto window = nativeWindow(hWindow);
+  if (window && window->request_client_size)
+    window->request_client_size(window->user, width, height);
 }
 
 bool setWindowMode(HMONITOR hMonitor, HWND hWindow, const WsiMode &mode) {
@@ -48,17 +73,35 @@ bool restoreDisplayMode(HMONITOR hMonitor) {
 }
 
 HMONITOR getWindowMonitor(HWND hWindow) {
-  return 0;
+  uint32_t display_id = 0;
+
+  auto window = nativeWindow(hWindow);
+  if (window && window->get_display_id)
+    display_id = window->get_display_id(window->user);
+
+  // an HMONITOR is a CGDirectDisplayID, see wsi_monitor_headless.cpp
+  return display_id ? reinterpret_cast<HMONITOR>(uintptr_t(display_id))
+                    : getDefaultMonitor();
 }
 
-bool isWindow(HWND hWindow) { return true; }
+bool isWindow(HWND hWindow) { return nativeWindow(hWindow) != nullptr; }
 
 void updateFullscreenWindow(HMONITOR hMonitor, HWND hWindow,
                             bool forceTopmost) {
 }
 
-bool isForeground(HWND hWindow) { return true; }
+bool isForeground(HWND hWindow) {
+  auto window = nativeWindow(hWindow);
+  if (window && window->is_foreground)
+    return window->is_foreground(window->user) != 0;
+  return true;
+}
 
-bool isMinimized(HWND hWindow) { return false; }
+bool isMinimized(HWND hWindow) {
+  auto window = nativeWindow(hWindow);
+  if (window && window->is_minimized)
+    return window->is_minimized(window->user) != 0;
+  return false;
+}
 
 } // namespace dxmt::wsi
diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
index 3327b29..9abdbbc 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -12,6 +12,9 @@
 #define WINEMETAL_API
 #include "../winemetal_thunks.h"
 #include "../airconv_thunks.h"
+#ifdef DXMT_NATIVE
+#include "native/dxmt_native_window.h"
+#endif
 
 typedef int NTSTATUS;
 #define STATUS_SUCCESS 0
@@ -1685,6 +1688,21 @@ static NTSTATUS
 _CreateMetalViewFromHWND(void *obj) {
   struct unixcall_create_metal_view_from_hwnd *params = obj;
 
+#ifdef DXMT_NATIVE
+  /*
+   * No Wine: the HWND is a DXMTNativeWindow owned by the host program, which
+   * also owns the CAMetalLayer.  The "view" handed back is that layer with a
+   * reference held on it until _ReleaseMetalView.
+   */
+  const struct DXMTNativeWindow *window = (const struct DXMTNativeWindow *)(uintptr_t)params->hwnd;
+  if (window && window->magic == DXMT_NATIVE_WINDOW_MAGIC && window->version == DXMT_NATIVE_WINDOW_VERSION &&
+      [(id)window->metal_layer isKindOfClass:CAMetalLayer.class]) {
+    CAMetalLayer *layer = [(CAMetalLayer *)window->metal_layer retain];
+    params->ret_view = (obj_handle_t)layer;
+    params->ret_layer = (obj_handle_t)layer;
+  }
+  return STATUS_SUCCESS;
+#else
   struct macdrv_win_data *(*pfn_get_win_data)(HWND hwnd) = NULL;
   void (*pfn_release_win_data)(struct macdrv_win_data *data) = NULL;
   macdrv_metal_view (*pfn_macdrv_view_create_metal_view)(macdrv_view v, macdrv_metal_device d) = NULL;
@@ -1716,12 +1734,17 @@ _CreateMetalViewFromHWND(void *obj) {
   }
 
   return STATUS_SUCCESS;
+#endif
 }
 
 static NTSTATUS
 _ReleaseMetalView(void *obj) {
   struct unixcall_generic_obj_noret *params = obj;
 
+#ifdef DXMT_NATIVE
+  [(CAMetalLayer *)params->handle release];
+  return STATUS_SUCCESS;
+#else
   void (*pfn_macdrv_view_release_metal_view)(macdrv_metal_view v) = NULL;
 
   struct macdrv_functions_t *macdrv_functions;
@@ -1735,6 +1758,7 @@ _ReleaseMetalView(void *obj) {
     pfn_macdrv_view_release_metal_view((macdrv_metal_view)params->handle);
 
   return STATUS_SUCCESS;
+#endif
 }
 
 static NTSTATUS
