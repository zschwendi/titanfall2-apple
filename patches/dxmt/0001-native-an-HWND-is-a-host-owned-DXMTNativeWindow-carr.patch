From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tfrecomp <tfrecomp@example.invalid>
Date: Thu, 8 Oct 2026 20:30:34 -0400
Subject: [PATCH 01/12] native: an HWND is a host-owned DXMTNativeWindow
 carrying the CAMetalLayer

In a native (no Wine) build the swap chain constructor asked Wine's Mac
driver for a Metal view and aborted without it, and the window functions
were headless stubs (1024x1024, always a window).

Define what a window is here: a pointer to a DXMTNativeWindow that the
host program owns (include/native/dxmt_native_window.h): its CAMetalLayer
plus optional callbacks for the client size, the display it is on, the
minimized and foreground state, and a windowed ResizeTarget() request.

- winemetal: CreateMetalViewFromHWND adopts (retains) that layer,
  ReleaseMetalView releases it.
- wsi_window_headless: answer from the handle instead of constants.
  Fullscreen and mode switches still report failure.
- d3d11: CreateSwapChain rejects an HWND that is not a window with
  DXGI_ERROR_INVALID_CALL instead of reaching the constructor's abort().
---
 include/native/dxmt_native_window.h | 87 +++++++++++++++++++++++++++++
 src/d3d11/d3d11_swapchain.cpp       |  5 ++
 src/util/wsi_window_headless.cpp    | 55 ++++++++++++++++--
 src/winemetal/unix/winemetal_unix.c | 24 ++++++++
 4 files changed, 165 insertions(+), 6 deletions(-)
 create mode 100644 include/native/dxmt_native_window.h

diff --git a/include/native/dxmt_native_window.h b/include/native/dxmt_native_window.h
new file mode 100644
index 0000000..ee91fd9
--- /dev/null
+++ b/include/native/dxmt_native_window.h
@@ -0,0 +1,87 @@
+/*
+ * What a window is to DXMT's native (no Wine) build.
+ *
+ * In a native build there is no Win32 window system behind an HWND.  The
+ * program that hosts DXMT owns the window and its CAMetalLayer and passes a
+ * pointer to a DXMTNativeWindow wherever DXGI takes an HWND
+ * (DXGI_SWAP_CHAIN_DESC::OutputWindow, IDXGIFactory2::CreateSwapChainForHwnd).
+ * DXMT never creates, resizes or destroys the window or the layer itself.
+ *
+ * Rules for the host:
+ *  - The struct must stay valid, at the same address, until every swap chain
+ *    created for it has been released.  DXMT stores the pointer and returns it
+ *    from IDXGISwapChain::GetDesc / IDXGISwapChain1::GetHwnd.
+ *  - metal_layer is created by the host (on whatever thread its window
+ *    toolkit requires, normally the main thread) before the swap chain.  DXMT
+ *    retains it for the life of each swap chain and sets its device,
+ *    pixelFormat, drawableSize (= the swap chain's size), colorspace, opaque,
+ *    framebufferOnly and displaySyncEnabled; it keeps the contentsScale it
+ *    finds.  Those writes are dispatched synchronously to the main queue, so
+ *    the main thread must keep servicing it (see execute_on_main).
+ *  - The callbacks may be called from any thread that calls into DXGI or
+ *    Direct3D, at any time while a swap chain exists.  They must not call back
+ *    into DXGI or Direct3D.  Any of them may be NULL.
+ *  - Sizes are in the unit the host wants swap chains to be in ("pixels" as
+ *    the application sees them).  DXMT does no scaling of its own.
+ */
+
+#ifndef DXMT_NATIVE_WINDOW_H
+#define DXMT_NATIVE_WINDOW_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define DXMT_NATIVE_WINDOW_MAGIC 0x574E5844u /* bytes 'D' 'X' 'N' 'W' */
+#define DXMT_NATIVE_WINDOW_VERSION 1u
+
+struct DXMTNativeWindow {
+  uint32_t magic;   /* DXMT_NATIVE_WINDOW_MAGIC */
+  uint32_t version; /* DXMT_NATIVE_WINDOW_VERSION */
+
+  /* CAMetalLayer *, owned by the host.  Required. */
+  void *metal_layer;
+
+  /* Passed back as the first argument of every callback. */
+  void *user;
+
+  /*
+   * Size of the client area.  Used only when the application asks for a
+   * swap chain or a ResizeBuffers() of width or height 0.
+   * NULL: such a request yields a 0x0 swap chain, as for a minimized window.
+   */
+  void (*get_client_size)(void *user, uint32_t *width, uint32_t *height);
+
+  /*
+   * CGDirectDisplayID of the display the window is on.  Used for the swap
+   * chain's refresh rate and for IDXGISwapChain::GetContainingOutput().
+   * NULL, or a return value of 0: the main display.
+   */
+  uint32_t (*get_display_id)(void *user);
+
+  /*
+   * Non-zero while the window is minimized.  Present() then presents nothing
+   * and returns DXGI_STATUS_OCCLUDED (for non-flip swap effects).
+   * NULL: never minimized.
+   */
+  int (*is_minimized)(void *user);
+
+  /* Non-zero while the window is the foreground window.  NULL: always. */
+  int (*is_foreground)(void *user);
+
+  /*
+   * IDXGISwapChain::ResizeTarget() in windowed mode: the application asks for
+   * a client area of this size.  The host may do it later and on another
+   * thread, and tells the application the way it tells it about any resize.
+   * NULL: the request is ignored.
+   */
+  void (*request_client_size)(void *user, uint32_t width, uint32_t height);
+};
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* DXMT_NATIVE_WINDOW_H */
